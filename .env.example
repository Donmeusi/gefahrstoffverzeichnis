# ==========================================
# Gefahrstoffverzeichnis - .env Konfiguration
# ==========================================

# Secret Key für Flask Sessions. Pflicht — ohne ihn startet die Anwendung
# nicht. Erzeugen mit:  openssl rand -base64 32
# Nie den Beispielwert übernehmen und niemals committen.
FLASK_SECRET_KEY=

# Hinter einem Reverse Proxy: IP bzw. CIDR des Proxys. Nur dieser darf dann
# X-Forwarded-Proto/-Host/-For setzen. Ohne Angabe uebernimmt die Anwendung
# diese Header von jedem Client - dann bestimmt der Aufrufer, ob die Sitzung
# als HTTPS gilt.
# TRUSTED_PROXY=172.18.0.0/16

# Alternative: X-Forwarded-* immer verwerfen, auch hinter einem Proxy.
# Dann muss SESSION_COOKIE_SECURE=true gesetzt werden.
# CLEAR_UNTRUSTED_PROXY_HEADERS=true

# Optionaler TLS-Abschluss ohne eigenen Reverse Proxy
# (docker compose --profile tls up -d). Name oder IP, unter der die Anwendung
# aufgerufen wird. Ohne Angabe: https://localhost mit Caddys lokaler CA.
# SITE_ADDRESS=192.168.1.10

# Fuer eine oeffentliche Domain mit Let's Encrypt:
# SITE_ADDRESS=gefahrstoffe.example.de
# CADDYFILE=Caddyfile.acme

# Auf welcher Adresse der Port veroeffentlicht wird. Standard 127.0.0.1
# (nur ueber einen Reverse Proxy erreichbar). Fuer direkten Zugriff aus dem
# LAN auf 0.0.0.0 oder die Server-IP setzen - dann laeuft die Anmeldung
# allerdings unverschluesselt ueber HTTP.
# BIND_ADDR=0.0.0.0

# Optional: Secure-Flag des Sitzungscookies erzwingen.
# Ohne Eintrag entscheidet der Zugriffsweg: HTTPS -> Secure, HTTP im LAN ->
# nicht Secure. Das passt für die meisten Installationen. Setzen Sie den Wert
# nur, wenn Ihr Reverse Proxy X-Forwarded-Proto nicht durchreicht.
# SESSION_COOKIE_SECURE=true

# ==========================================
# LDAPs (LDAP over SSL/TLS) Einstellungen
# ==========================================

# LDAPs Authentifizierung aktivieren (true / false)
LDAP_ENABLED=false

# LDAP Server Host (z.B. ldaps://ldap.beispiel.de oder ldap.beispiel.de)
LDAP_HOST=ldaps://ldap.beispiel.de

# LDAP Server Port (636 für LDAPs, 389 für LDAP mit StartTLS)
LDAP_PORT=636

# SSL/TLS aktivieren (true / false). Bei Port 636 ist SSL immer aktiv.
LDAP_USE_SSL=true

# StartTLS für unverschlüsseltes LDAP auf Port 389 (true / false).
# Standard ist true: Die Verbindung wird vor dem Bind auf TLS hochgezogen,
# das Passwort geht also nicht im Klartext über das Netz. Sind weder
# LDAP_USE_SSL noch LDAP_START_TLS aktiv, verweigert die Anwendung den
# LDAP-Login und schreibt beim Start eine Warnung ins Log.
LDAP_START_TLS=true

# Base DN für die Suche
LDAP_BASE_DN=dc=beispiel,dc=de

# Bind DN für Service Account (falls direkte Suche erforderlich ist)
LDAP_BIND_DN=cn=service_gefahrstoff,ou=services,dc=beispiel,dc=de
LDAP_BIND_PASSWORD=ServiceAccountPasswort

# Benutzer-Suchfilter (z.B. sAMAccountName={username} für Active Directory oder uid={username} für OpenLDAP)
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})

# Alternativ: Direktes User-DN-Template (z.B. uid={username},ou=users,dc=beispiel,dc=de)
# LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=beispiel,dc=de

# Standardrolle für neue LDAP-Benutzer beim ersten Login (lesen | benutzer | moderator | admin)
LDAP_DEFAULT_ROLE=lesen

# Zertifikat des Servers pruefen. Standard ist true.
# Fuer eine eigene/interne PKI nicht auf false setzen, sondern das CA-Bundle
# hinterlegen - sonst gehen Anmeldedaten ungeprueft an den Verzeichnisdienst.
LDAP_REQUIRE_CERT=true

# CA-Bundle fuer die Pruefung (PEM). Leer = System-Speicher.
# LDAP_CA_CERT_FILE=/certs/unternehmens-ca.pem
