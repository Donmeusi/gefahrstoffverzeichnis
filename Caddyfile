# Standard-Variante: TLS mit Caddys lokaler CA (selbstsigniert).
#
# Start:  docker compose --profile tls up -d
# Aufruf: https://<SITE_ADDRESS>
#
# SITE_ADDRESS steht in der .env und ist Name oder IP, unter der die
# Anwendung aufgerufen wird - ohne Schema, z. B.
#
#   SITE_ADDRESS=192.168.1.10
#   SITE_ADDRESS=gefahrstoffe.firma.intern
#
# Ohne Angabe laeuft es auf localhost.
#
# default_sni ist fuer den Zugriff ueber eine IP noetig: Browser und curl
# senden bei IP-Adressen kein SNI, Caddy findet das Zertifikat dann ohne
# diesen Rueckfallwert nicht und bricht den Handshake mit "internal error" ab.
#
# Der Browser zeigt beim ersten Aufruf eine Warnung, weil die CA unbekannt
# ist. Dauerhaft warnungsfrei wird es, wenn die CA aus
# /data/caddy/pki/authorities/local/root.crt auf den Geraeten als
# vertrauenswuerdig eingetragen wird - oder man nimmt mit einer
# oeffentlichen Domain Caddyfile.acme.

{
	default_sni {$SITE_ADDRESS:localhost}
}

https://{$SITE_ADDRESS:localhost} {
	tls internal

	encode zstd gzip

	# Host-Header bleibt erhalten, damit url_for(_external=True) die richtige
	# Adresse in QR-Codes schreibt.
	reverse_proxy web:5000
}
